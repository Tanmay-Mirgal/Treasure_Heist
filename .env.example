# ── THE HEIST — environment configuration ─────────────────────────────
# Copy to .env.local (never commit real values).

# MongoDB connection string. Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/the_heist
# Local (single-node replica set, needed for transactions):
#   mongodb://127.0.0.1:27017/the_heist?replicaSet=rs0
# MONGO_URI is also accepted for compatibility.
MONGODB_URI=
# Optional: database name override (otherwise taken from the URI path).
MONGODB_DB=

# Signs session cookies. REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Session lifetime in hours (default 12).
SESSION_TTL_HOURS=12

# Initial administrator created by `npm run db:seed` (only if it does not exist).
# The default Tanmay123 must be changed at /admin/account before the event.
ADMIN_USERNAME=Tanmay
ADMIN_INITIAL_PASSWORD=Tanmay123

# Public URL of the deployed site. Printed QR codes encode
#   ${NEXT_PUBLIC_APP_URL}/s/<token>
# Leave empty in development to use the current request origin.
NEXT_PUBLIC_APP_URL=

# Optional: workbook path for `npm run db:import` (default data/import/HEIST.xlsx).
HEIST_WORKBOOK=
